{
  "name": "aquilifer-types",
  "description": "TypeScript types and tiny runtime helpers for window.aquilifer",
  "license": "Apache-2.0",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "compile": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "openai": "^7.15.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/On0n0k1/aquilifer-types.git"
  },
  "keywords": [
    "aquilifer",
    "llm",
    "types",
    "browser-extension"
  ],
  "author": "Lucas Alessandro do Carmo Lemos"
}
